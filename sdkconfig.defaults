# Rust often needs a bit of an extra main task stack size compared to C (the default is 3K)
# You might have to increase this further if you allocate large stack variables in the main task
# The Luanti server runs in the main task, and has grown: 16 KB once
# overflowed into the heap after a login.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768

# Increase a bit these stack sizes as they are also a bit too small by default
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096

# You might have to increase this further if you spawn your own Rust threads 
# that allocate large stack variables; or better yet - use 
# `std::thread::Builder::new().stack_size(XXX)` for spawning
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_USE_MALLOC=y

CONFIG_FATFS_LFN_HEAP=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM_SPEED_80M=y

CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# Wi-Fi throughput, after ESP-IDF's iperf example for the ESP32-S3
# (examples/wifi/iperf/sdkconfig.defaults.esp32s3). The Wi-Fi driver's and
# lwIP's buffers stay in internal RAM (no SPIRAM_TRY_ALLOCATE_WIFI_LWIP):
# copying every packet through PSRAM held sending back, so the driver's
# transmit buffers filled even with a strong signal. This costs some
# 50 to 80 KB of internal RAM at full load; the stack report logs how much
# is left ("Internal RAM: ...").
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_RX_BA_WIN=32
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y
CONFIG_LWIP_IRAM_OPTIMIZATION=y
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64

# Per-task CPU time, for the CPU load figures on the status screen
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# Stop at once, naming the task, if any task overflows its stack (rather than
# corrupting the memory next to it and crashing later somewhere else).
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y

# Guard words round every heap block, so an overrun is caught at the block
# it damages (checked by the server's periodic heap check, and on free).
CONFIG_HEAP_POISONING_LIGHT=y
